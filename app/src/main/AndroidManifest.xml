<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Разрешения — по D-008 и правилам Google Play (D-006, п. 10). -->
    <!-- Будильники и таймеры: точное время; выдаётся при установке, отозвать нельзя. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Android 12–12L: USE_EXACT_ALARM там нет, точные будильники разрешает человек. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Подтверждение пробуждения QR-кодом или снимком (D-015); спрашивается, только когда выбран такой способ. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Погода вашего города в «Мировых часах» (D-019): только запросы к MET Norway. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Погода по геолокации (D-019): приблизительное место, спрашивается, только когда выбран такой способ. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Без камеры приложение ставится: остаются другие способы проверки. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- «После будильника — открыть приложение» (D-017): список приложений с иконкой на рабочем столе. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Будильники, пресеты и настройки — в системной копии и при переносе на новое устройство (D-006, п. 9). -->
    <application
        android:name=".DpClockApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DpClock">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Экран сигнала: поверх блокировки и до первой разблокировки после перезагрузки (D-008, п. 5). -->
        <activity
            android:name=".RingActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <!-- Ночные часы (D-017): из раздела «Часы» и заставкой Android на зарядке. -->
        <activity
            android:name=".NightClockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true" />

        <service
            android:name=".NightDream"
            android:exported="true"
            android:label="@string/night_clock"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <service
            android:name=".platform.RingService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <receiver
            android:name=".platform.AlarmReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name=".platform.ActionReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Пересчёт расписаний: загрузка, смена времени и пояса, обновление (D-008, п. 5). -->
        <receiver
            android:name=".platform.SystemEventsReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
