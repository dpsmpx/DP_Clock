<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Разрешения — по D-008 и правилам Google Play (D-006, п. 10). -->
    <!-- Будильники и таймеры: точное время; выдаётся при установке, отозвать нельзя. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Android 12–12L: USE_EXACT_ALARM там нет, точные будильники разрешает человек. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Подтверждение пробуждения QR-кодом или снимком (D-015); спрашивается, только когда выбран такой способ. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Погода вашего города в «Мировых часах» (D-019): только запросы к MET Norway. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Погода по геолокации (D-019): приблизительное место, спрашивается, только когда выбран такой способ. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Календарь телефона (D-023): только чтение, спрашивается, когда выбирают календари. События не покидают телефон. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- «Не беспокоить» на работу помидора (D-025): доступ даёт человек в настройках Android, когда включает флажок. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Живые обои (D-024) — по желанию: без них приложение ставится. -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />
    <!-- Без камеры приложение ставится: остаются другие способы проверки. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- «После будильника — открыть приложение» (D-017): список приложений с иконкой на рабочем столе. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Будильники, пресеты и настройки — в системной копии и при переносе на новое устройство (D-006, п. 9). -->
    <application
        android:name=".DpClockApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DpClock">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Ярлыки на иконке (D-020). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          Стандартные команды Android (D-020): ассистент и другие приложения ставят
          будильник и таймер. Вызвать могут только приложения с разрешением SET_ALARM.
        -->
        <activity
            android:name=".AssistantActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="com.android.alarm.permission.SET_ALARM"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SET_ALARM" />
                <action android:name="android.intent.action.SET_TIMER" />
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <action android:name="android.intent.action.SHOW_TIMERS" />
                <action android:name="android.intent.action.SNOOZE_ALARM" />
                <action android:name="android.intent.action.DISMISS_ALARM" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.VOICE" />
            </intent-filter>
        </activity>

        <!-- Экран сигнала: поверх блокировки и до первой разблокировки после перезагрузки (D-008, п. 5). -->
        <activity
            android:name=".RingActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <!-- Ночные часы (D-017): из раздела «Часы» и заставкой Android на зарядке. -->
        <activity
            android:name=".NightClockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true" />

        <service
            android:name=".NightDream"
            android:exported="true"
            android:label="@string/night_clock"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <service
            android:name=".platform.RingService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <!--
          Живые обои DP Clock (D-024): эффект из настроек на рабочем столе и экране
          блокировки. Настройки — в базе хранилища устройства: рисуются и до разблокировки.
        -->
        <service
            android:name=".platform.ClockWallpaper"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- Календарь телефона изменился или прошло полдня — перечитать (D-023, п. 6). -->
        <service
            android:name=".platform.CalendarJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Виджеты (D-020). -->
        <receiver
            android:name=".platform.ClockWidget"
            android:exported="false"
            android:label="@string/widget_clock_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>

        <receiver
            android:name=".platform.AlarmsWidget"
            android:exported="false"
            android:label="@string/widget_alarms_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_alarms_info" />
        </receiver>

        <receiver
            android:name=".platform.TimersWidget"
            android:exported="false"
            android:label="@string/widget_timers_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_timers_info" />
        </receiver>

        <receiver
            android:name=".platform.WorldWidget"
            android:exported="false"
            android:label="@string/widget_world_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_world_info" />
        </receiver>

        <!-- Плитки быстрых настроек (D-020). -->
        <service
            android:name=".platform.SleepTimerTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_moon"
            android:label="@string/sleep_timer"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".platform.NextAlarmTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_alarm"
            android:label="@string/tile_next_alarm"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".platform.LastTimerTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_timer"
            android:label="@string/tile_last_timer"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".platform.StopwatchTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_stopwatch"
            android:label="@string/section_stopwatch"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".platform.AlarmReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name=".platform.ActionReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Пересчёт расписаний: загрузка, смена времени и пояса, обновление (D-008, п. 5). -->
        <receiver
            android:name=".platform.SystemEventsReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
